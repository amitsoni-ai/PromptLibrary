# ── Synottic Prompt Library — environment ────────────────────────────────────
# Copy to .env (git-ignored) for local dev, or set in Vercel → Settings → Env Vars.

# Database. Production: Neon pooled connection string.
# Local dev/test without a real DB: pglite://memory  or  pglite:///abs/path
# To make localhost behave EXACTLY like production, use the SAME value here as in
# Vercel (see SHARED-DB.md): `vercel env pull .env.local` then `npm run dev`.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secrets (use long random values)
SESSION_SECRET="change-me-to-a-64-char-random-string"
ADMIN_SECRET="the-legacy-admin-console-key"

# Absolute origin used in verification / reset email links
APP_BASE_URL="https://library.synottic.com"

# Email — "console" (default; prints to logs + GET /api/dev/outbox) or "resend".
#   devserver_pglite.mjs auto-selects "resend" when RESEND_API_KEY is set.
EMAIL_TRANSPORT="resend"
RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM must be an address on a domain verified in the Resend dashboard
# (synottic.com is verified). Any recipient is allowed once the domain is verified.
EMAIL_FROM="Synottic <info@synottic.com>"

# First super-admin (used by migrate/run_v2.mjs and the /api/admin/session bootstrap)
ADMIN_BOOTSTRAP_EMAIL="you@synottic.com"
ADMIN_BOOTSTRAP_PASSWORD="a-long-initial-password-change-after-first-login"

# Optional: seed a DEMO-LEARNER access code (full library, trial)
# SEED_DEMO_ACCESS_CODE="1"
