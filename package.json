{
  "name": "synottic-prompt-library",
  "private": true,
  "type": "module",
  "description": "Synottic Prompt Library — static frontend (index.html) + Vercel serverless API on Neon Postgres. index.html is prebuilt (src/build.py); Vercel runs no build step.",
  "scripts": {
    "migrate": "node migrate/run.mjs",
    "migrate:v2": "node migrate/run_v2.mjs",
    "make:admin": "node migrate/make_admin.mjs",
    "apitest": "node migrate/apitest.mjs",
    "authtest": "node migrate/authtest.mjs",
    "loadtest": "node migrate/loadtest.mjs",
    "migrate:v3": "node migrate/run_v3.mjs",
    "migrate:v5": "node migrate/run_v5.mjs",
    "dev": "node devserver.mjs",
    "dev:auth": "node migrate/devserver_pglite.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
