{
  "name": "synottic-prompt-library-web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js strangler app for the Synottic Prompt Library — Library screen (Phase 2) behind LIBRARY_V2, ported read API at /api/v2 (Phase 1). Legacy index.html + /api stay untouched at the same origin.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:pull": "drizzle-kit pull",
    "db:guard": "node scripts/guard-no-migrations.mjs",
    "seed:verify": "node scripts/verify-prompts.mjs",
    "parity": "node scripts/parity.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/nextjs": "^8.47.0",
    "@tanstack/react-query": "^5.62.7",
    "@vercel/speed-insights": "^1.1.0",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
