# ── Synottic Prompt Library — web/ (Next.js strangler) ───────────────────────
# Copy to .env.local for local dev. NEVER point at prod for dev — use a Neon dev
# branch (see SHARED-DB.md in the repo root).

# Legacy zone origin — the untouched index.html + /api/** deployment that this
# app proxies for /api/** and /legacy. Local: the pglite devserver.
LEGACY_ORIGIN="http://localhost:8790"

# Database (Drizzle + /api/v2 read endpoints). Same driver surface as legacy:
#   local/test:  pglite://memory
#   dev/prod:    postgresql://…-pooler…/neondb?sslmode=require  (Neon dev branch!)
DATABASE_URL="pglite://memory"

# Signs/verifies the legacy code-session + admin HMAC tokens. Must MATCH the
# legacy zone so /api/v2 can verify sessions when needed.
SESSION_SECRET="change-me-to-match-the-legacy-zone"

# ── Feature flags (rollback switches, one per ported screen — independently
# revertable, see web/src/lib/flags.ts) ──────────────────────────────────────
# Master defaults. OFF ships the legacy screen. Per-request override: ?v2=1 /
# ?home=1 and their sticky cookies (libraryV2 / homeV2) always win over these.
LIBRARY_V2="off"
HOME_V2="off"
# Optional allowlists: comma list of user ids and/or org names that get V2
# while the master flag is still off (independent per screen).
# LIBRARY_V2_ALLOW="user_123,Acme Corp"
# HOME_V2_ALLOW="user_123,Acme Corp"

# Public marketing landing page for LOGGED-OUT visitors to `/`. DEFAULT ON — an
# anonymous `/` is served by Next as the branded landing page. Set to "off" to
# roll back (anonymous `/` then rewrites to the legacy sign-in / access-code
# gate, byte-for-byte the pre-landing behaviour). Independent of HOME_V2;
# authenticated `/` is unaffected either way. Per-request override: ?landing=1 /
# ?landing=0 (sticky cookie: landingV2).
LANDING_V2="on"

# ── Cache invalidation ───────────────────────────────────────────────────────
# Secret guarding POST /api/v2/revalidate (busts the prompts/categories cache
# tags after a legacy admin prompt edit).
REVALIDATE_SECRET="change-me"

# ── Observability (optional locally) ─────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
